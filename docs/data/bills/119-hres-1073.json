    "description": {
      "source": "Congress.gov bill summary",
      "text": "This resolution supports the designation of National FFA (Future Farmers of America) Week. It also celebrates the 50th anniversary of the chartering of Alaska as a State FFA Association of the National FFA Organization.",
      "updated_at": "2026-04-03T10:51:45Z"
    },
    "detailPath": "119/hres/1073",
    "identifier": "HRES 1073",
    "introducedDate": "2026-02-23",
    "latestAction": {
      "date": "2026-02-23",
      "text": "Referred to the House Committee on Agriculture."
    },
    "number": "1073",
    "originChamber": "House",
    "policyArea": "Agriculture and Food",
